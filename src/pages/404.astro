---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { PILAR_URL, TEMAS, urlTema } from '../temas';
import { postsPublicados, urlPost } from '../lib/posts';

const recentes = (await postsPublicados()).filter((p) => !p.data.pilar).slice(0, 3);
---
<Base titulo="Página não encontrada" descricao="Essa página não existe ou mudou de endereço. Veja os caminhos mais procurados do site Avaliações que Vendem." semIndex>
  <section class="pagina-curta"><div class="container leitura centro">
    <span class="selo">Erro 404</span>
    <h1>Essa página não existe, mas o caminho continua</h1>
    <p>O endereço pode ter mudado ou o link estava errado. Escolha por onde seguir:</p>

    <div class="atalhos-404">
      <a href={PILAR_URL}>Guia completo<small>Tudo sobre avaliações no Google</small></a>
      {TEMAS.map((t) => <a href={urlTema(t)}>{t.nome}<small>Ver artigos sobre o tema</small></a>)}
    </div>

    {recentes.length > 0 && (
      <>
        <h2>Artigos mais recentes</h2>
        <ul class="lista-links">{recentes.map((p) => <li><a href={urlPost(p)}>{p.data.titulo}</a></li>)}</ul>
      </>
    )}

    <div class="acoes">
      <a class="botao" href={SITE.whatsapp.analise}>Pedir análise do meu perfil</a>
      <a class="botao secundario" href="/">Página inicial</a>
    </div>
    <p class="nota-cta"><span class="prazo">{SITE.prazoResposta}</span> pelo WhatsApp {SITE.whatsappExibicao}.</p>
  </div></section>
</Base>
