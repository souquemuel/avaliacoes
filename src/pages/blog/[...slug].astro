---
// Endereços antigos (/blog/<artigo>/) → novos (/avaliacoes-no-google/...).
// Gera páginas de redirecionamento imediato (tratadas pelo Google como permanentes).
import { SITE } from '../../config';

export function getStaticPaths() {
  const mapa: Record<string, string> = {
    'guia-completo-avaliacoes-google': '/avaliacoes-no-google/',
    'como-pedir-avaliacoes-no-google': '/avaliacoes-no-google/como-pedir-avaliacoes/',
    'como-responder-avaliacoes-negativas': '/avaliacoes-no-google/responder-avaliacoes-negativas/',
    'texto-das-avaliacoes-importa-mais-que-a-nota': '/avaliacoes-no-google/texto-das-avaliacoes/',
  };
  return Object.entries(mapa).map(([slug, destino]) => ({ params: { slug }, props: { destino } }));
}
const { destino } = Astro.props;
const abs = new URL(destino, SITE.url).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Página movida</title>
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={abs} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body><p>Esta página mudou de endereço: <a href={destino}>{abs}</a></p></body>
</html>
