---
import Base from '../../layouts/Base.astro';
import CartaoPost from '../../layouts/CartaoPost.astro';
import { postsPublicados, urlPost } from '../../lib/posts';
import { TEMAS, urlTema } from '../../temas';
const posts = await postsPublicados();
const pilar = posts.find((p) => p.data.pilar);
const artigos = posts.filter((p) => !p.data.pilar);
const schema = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Blog Avaliações que Vendem',
  hasPart: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.titulo, url: `https://avaliacoesquevendem.com.br${urlPost(p)}` })),
}];
---
<Base titulo="Blog: avaliações no Google e Google Meu Negócio" descricao="Artigos práticos sobre como pedir, responder e usar avaliações do Google (Google Meu Negócio) para o cliente escolher a sua empresa." trilha={[{ nome: 'Blog' }]} trilhaEscura schema={schema}>
  <section class="pagina-topo">
    <div class="container">
      <span class="selo">Blog</span>
      <h1>Avaliações no Google, do pedido à venda</h1>
      <p class="intro-secao">Artigos práticos para transformar avaliações do Google Meu Negócio em clientes. Escolha um tema:</p>
      <nav class="filtros" aria-label="Temas">
        {TEMAS.map((t) => <a href={urlTema(t)}>{t.nome}</a>)}
      </nav>
    </div>
  </section>
  <section class="pagina-corpo">
    <div class="container">
      {pilar && <CartaoPost post={pilar} destaque nivel="h2" />}
      <div class="cabeca-secao" style="margin-top:64px"><h2>Todos os artigos</h2><span class="meta">{artigos.length} artigos</span></div>
      <div class="grade-posts">
        {artigos.map((p) => <CartaoPost post={p} />)}
      </div>
    </div>
  </section>
</Base>
