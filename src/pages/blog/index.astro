---
import Base from '../../layouts/Base.astro';
import { postsPublicados, urlPost } from '../../lib/posts';
import { TEMAS, PILAR_URL, urlTema } from '../../temas';
const posts = await postsPublicados();
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const schema = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Blog Avaliações que Vendem',
  hasPart: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.titulo, url: `https://avaliacoesquevendem.com.br${urlPost(p)}` })),
}];
---
<Base titulo="Blog: avaliações no Google e Google Meu Negócio" descricao="Artigos práticos sobre como pedir, responder e usar avaliações do Google (Google Meu Negócio) para o cliente escolher a sua empresa." trilha={[{ nome: 'Blog' }]} schema={schema}>
  <section class="artigo" style="padding-top:8px">
    <div class="container">
      <span class="selo">Blog</span>
      <h1>Avaliações no Google, do pedido à venda</h1>
      <p class="intro-secao">Comece pelo <a href={PILAR_URL}>guia completo</a> ou escolha um tema. Cada artigo resolve uma dúvida prática sobre avaliações no Google Meu Negócio.</p>
      {TEMAS.map((t) => {
        const lista = posts.filter((p) => p.data.tema === t.id);
        return lista.length ? (
          <section>
            <h2><a href={urlTema(t)} style="color:inherit;text-decoration:none">{t.nome}</a></h2>
            <p class="meta">{t.descricao}</p>
            <div class="grade" style="margin-top:16px">
              {lista.map((p) => (
                <article class="cartao">
                  <p class="meta">{fmt(p.data.data)}</p>
                  <h3><a class="titulo" href={urlPost(p)}>{p.data.titulo}</a></h3>
                  <p>{p.data.descricao}</p>
                </article>
              ))}
            </div>
          </section>
        ) : null;
      })}
    </div>
  </section>
</Base>
