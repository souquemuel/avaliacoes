---
import Base from '../../layouts/Base.astro';
import { NICHOS } from '../../nichos';
import { PILAR_URL } from '../../temas';
---
<Base titulo="Avaliações no Google por segmento" descricao="Estratégias de avaliações no Google para restaurantes, clínicas, imobiliárias e outros negócios locais, com as dúvidas típicas de cada cliente." trilha={[{ nome: 'Segmentos' }]} trilhaEscura>
  <section class="pagina-topo"><div class="container">
    <span class="selo">Segmentos</span>
    <h1>Avaliações no Google para o seu tipo de negócio</h1>
    <p class="intro-secao">Cada segmento tem dúvidas próprias do cliente. Escolha o seu ou comece pelo <a href={PILAR_URL}>guia completo de avaliações no Google</a>.</p>
  </div></section>
  <section class="pagina-corpo"><div class="container">
    <div class="grade-posts">
      {NICHOS.map((n) => (
        <article class="card-post">
          <a class="card-capa" href={`/avaliacoes-para/${n.slug}/`} tabindex="-1" aria-hidden="true"><img src={`/capas/${n.capa}-768.webp`} width="768" height="432" loading="lazy" decoding="async" alt={n.capaAlt} /></a>
          <div class="card-corpo">
            <h2 class="card-titulo"><a href={`/avaliacoes-para/${n.slug}/`}>{n.nome}</a></h2>
            <p class="card-resumo">{n.descricao}</p>
          </div>
        </article>
      ))}
    </div>
  </div></section>
</Base>
