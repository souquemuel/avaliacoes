---
import { capaSvg, fotoCapa, tempoLeitura } from '../lib/capa';
import { urlPost, type Post } from '../lib/posts';
import { temaPorId } from '../temas';
interface Props { post: Post; destaque?: boolean; nivel?: 'h2' | 'h3' }
const { post, destaque = false, nivel = 'h3' } = Astro.props;
const url = urlPost(post);
const tema = temaPorId(post.data.tema)?.nome ?? 'Guia completo';
const min = tempoLeitura(post.body);
const Titulo = nivel;
const foto = post.data.capa ? fotoCapa(post.data.capa) : null;
---
<article class:list={['card-post', { destaque }]}>
  {foto ? (
    <a class="card-capa" href={url} tabindex="-1" aria-hidden="true">
      <img src={foto.media} srcset={`${foto.media} 768w, ${foto.grande} 1536w`} sizes={destaque ? '(max-width: 860px) 100vw, 600px' : '(max-width: 700px) 100vw, 380px'} width="768" height="432" loading="lazy" decoding="async" alt={post.data.capaAlt ?? ''} />
    </a>
  ) : (
    <a class="card-capa" href={url} tabindex="-1" aria-hidden="true" set:html={capaSvg(post.data.tema, post.id)} />
  )}
  <div class="card-corpo">
    <p class="card-meta"><span class="chip">{tema}</span><span>{min} min de leitura</span></p>
    <Titulo class="card-titulo"><a href={url}>{post.data.titulo}</a></Titulo>
    <p class="card-resumo">{destaque ? post.data.resumo : post.data.descricao}</p>
    {destaque && <a class="botao" href={url}>Ler o guia completo</a>}
  </div>
</article>
