---
import { SITE, linkEbook } from '../config';
interface Props { titulo?: string; texto?: string; botao?: string; link?: string; semEbook?: boolean }
const {
  titulo = 'Quer saber se as suas avaliações estão vendendo?',
  texto = 'Me chame no WhatsApp: eu analiso o perfil da sua empresa no Google, dou uma nota de 0 a 100 e mostro o que dá para melhorar.',
  botao = 'Quero minha análise pelo WhatsApp',
  link = SITE.whatsapp.analise,
  semEbook = false,
} = Astro.props;
---
<aside class="chamada" aria-label="Fale comigo">
  <h2>{titulo}</h2>
  <p>{texto}</p>
  <div class="acoes"><a class="botao" href={link} rel="noopener">{botao}</a></div>
  <p class="nota-cta"><span class="prazo">{SITE.prazoResposta}</span> · Sem compromisso: basta informar o nome da empresa e a cidade.{!semEbook && <> Prefere aprender sozinho? <a href={linkEbook} rel="noopener" style="color:#fff">Conheça o ebook</a>.</>}</p>
</aside>
