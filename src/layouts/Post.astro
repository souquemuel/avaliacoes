---
import Base from './Base.astro';
import Chamada from './Chamada.astro';
import { SITE } from '../config';

interface Props {
  titulo: string;
  descricao: string;
  data: Date;
  atualizado?: Date;
  categoria: string;
  faq?: { pergunta: string; resposta: string }[];
}
const { titulo, descricao, data, atualizado, categoria, faq } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: titulo,
    description: descricao,
    datePublished: data.toISOString(),
    dateModified: (atualizado ?? data).toISOString(),
    mainEntityOfPage: url,
    inLanguage: 'pt-BR',
    author: { '@type': 'Person', '@id': `${SITE.url}/sobre/#quemuel`, name: SITE.autor, url: `${SITE.url}/sobre/` },
    publisher: { '@id': `${SITE.url}/#organizacao` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: titulo, item: url },
    ],
  },
];
if (faq?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })),
  });
}
---
<Base titulo={titulo} descricao={descricao} tipo="article" schema={schema}>
  <article class="artigo">
    <div class="container leitura">
      <nav class="trilha" aria-label="Trilha"><a href="/">Início</a> › <a href="/blog/">Blog</a> › {categoria}</nav>
      <h1>{titulo}</h1>
      <p class="meta">
        Por <a href="/sobre/">{SITE.autor}</a> · <time datetime={data.toISOString()}>{fmt(data)}</time>
        {atualizado && <> · atualizado em <time datetime={atualizado.toISOString()}>{fmt(atualizado)}</time></>}
      </p>
      <div class="conteudo">
        <slot />
      </div>
      {faq?.length && (
        <section class="faq">
          <h2>Perguntas frequentes</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.pergunta}</summary>
              <p>{f.resposta}</p>
            </details>
          ))}
        </section>
      )}
      <Chamada />
    </div>
  </article>
</Base>
