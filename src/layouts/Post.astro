---
import Base from './Base.astro';
import Chamada from './Chamada.astro';
import { SITE } from '../config';
import { temaPorId, PILAR_URL, TEMAS, urlTema } from '../temas';
import { capaSvg, fotoCapa, tempoLeitura } from '../lib/capa';

interface Link { titulo: string; url: string }
interface Props {
  slug: string;
  corpo?: string;
  titulo: string;
  tituloSeo?: string;
  descricao: string;
  resumo: string;
  palavraChave: string;
  capa?: string;
  capaAlt?: string;
  tema: string;
  pilar?: boolean;
  data: Date;
  atualizado?: Date;
  faq?: { pergunta: string; resposta: string }[];
  headings: { depth: number; slug: string; text: string }[];
  relacionados: Link[];
  porTema?: Record<string, Link[]>;
}
const { slug, corpo, titulo, tituloSeo, descricao, resumo, palavraChave, capa, capaAlt, tema, pilar, data, atualizado, faq, headings, relacionados, porTema } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const t = temaPorId(tema);
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
const secoes = headings.filter((h) => h.depth === 2);
const min = tempoLeitura(corpo);
const foto = capa ? fotoCapa(capa) : null;
const imagemSocial = foto ? foto.social : '/og.jpg';

const trilha = pilar
  ? [{ nome: 'Avaliações no Google' }]
  : [{ nome: 'Avaliações no Google', url: PILAR_URL }, ...(t ? [{ nome: t.nome, url: urlTema(t) }] : []), { nome: titulo }];

const schema: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descricao,
  abstract: resumo,
  keywords: palavraChave,
  image: { '@type': 'ImageObject', url: `${SITE.url}${imagemSocial}`, width: 1200, height: 630 },
  datePublished: data.toISOString(),
  dateModified: (atualizado ?? data).toISOString(),
  mainEntityOfPage: url,
  inLanguage: 'pt-BR',
  timeRequired: `PT${min}M`,
  ...(t ? { articleSection: t.nome } : {}),
  author: { '@type': 'Person', '@id': `${SITE.url}/sobre/#quemuel`, name: SITE.autor, url: `${SITE.url}/sobre/` },
  publisher: { '@id': `${SITE.url}/#organizacao` },
}];
if (faq?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })),
  });
}
---
<Base titulo={tituloSeo ?? titulo} descricao={descricao} tipo="article" schema={schema} trilha={trilha} trilhaEscura imagem={imagemSocial}>
  <header class="post-topo">
    <div class="container post-topo-grade">
      <div>
        <p class="card-meta">
          <span class="chip">{t ? t.nome : 'Guia completo'}</span>
          <span>{min} min de leitura</span>
        </p>
        <h1>{titulo}</h1>
        <div class="post-autor">
          <span class="monograma" aria-hidden="true">QV</span>
          <span>Por <a href="/sobre/">{SITE.autor}</a><br /><time datetime={data.toISOString()}>{fmt(data)}</time>{atualizado && <> · atualizado em <time datetime={atualizado.toISOString()}>{fmt(atualizado)}</time></>}</span>
        </div>
        <p class="cta-topo">Quer saber como está o perfil da sua empresa? <a href={SITE.whatsapp.analise}>Peça uma análise gratuita →</a></p>
      </div>
      {foto ? (
        <div class="post-capa"><img src={foto.grande} srcset={`${foto.media} 768w, ${foto.grande} 1536w`} sizes="(max-width: 860px) 100vw, 480px" width="1536" height="864" fetchpriority="high" decoding="async" alt={capaAlt ?? ''} /></div>
      ) : (
        <div class="post-capa" set:html={capaSvg(tema, slug)} />
      )}
    </div>
  </header>

  <div class="container post-grade">
    <article class="post-corpo">
      <div class="resumo"><strong>Resposta rápida</strong><p>{resumo}</p></div>
      {secoes.length >= 3 && (
        <details class="indice indice-mobile">
          <summary>Neste artigo</summary>
          <ol>{secoes.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <div class="conteudo">
        <slot />
      </div>

      {pilar && porTema && (
        <section class="relacionados">
          <h2>Todos os artigos do guia</h2>
          <div class="lista-temas">
            {TEMAS.map((tm) => porTema[tm.id]?.length ? (
              <div class="cartao">
                <h3><a href={urlTema(tm)}>{tm.nome}</a></h3>
                <ul>{porTema[tm.id].map((p) => <li><a href={p.url}>{p.titulo}</a></li>)}</ul>
              </div>
            ) : null)}
          </div>
        </section>
      )}

      {faq?.length && (
        <section class="faq">
          <h2>Perguntas frequentes</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.pergunta}</summary>
              <p>{f.resposta}</p>
            </details>
          ))}
        </section>
      )}

      {!pilar && (
        <nav class="relacionados" aria-label="Continue lendo">
          <h2>Continue lendo</h2>
          <ul class="lista-links">
            <li><a href={PILAR_URL}>Guia completo: como transformar avaliações do Google em clientes</a></li>
            {relacionados.map((r) => <li><a href={r.url}>{r.titulo}</a></li>)}
            {t && <li><a href={urlTema(t)}>Todos os artigos sobre {t.nome.toLowerCase()}</a></li>}
          </ul>
        </nav>
      )}

      <div class="autor">
        <span class="monograma grande" aria-hidden="true">QV</span>
        <p><strong><a href="/sobre/">{SITE.autor}</a></strong><br />Especialista em posicionamento no Google e criador do método Avaliações que Vendem. À frente da {SITE.marca}, já atendeu mais de 1.700 clientes.</p>
      </div>

      <Chamada />
    </article>

    <aside class="post-lateral" aria-label="Navegação do artigo">
      <div class="lateral-fixa">
        {secoes.length >= 3 && (
          <nav class="indice-lateral" aria-label="Neste artigo">
            <p class="lateral-titulo">Neste artigo</p>
            <ol>{secoes.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="lateral-cta">
          <p class="lateral-titulo">Análise gratuita</p>
          <p>Descubra a nota de 0 a 100 do perfil da sua empresa no Google.</p>
          <a class="botao botao-bloco" href={SITE.whatsapp.analise}>Pedir no WhatsApp</a>
          <p class="nota-cta"><span class="prazo">{SITE.prazoResposta}</span></p>
        </div>
      </div>
    </aside>
  </div>
</Base>
